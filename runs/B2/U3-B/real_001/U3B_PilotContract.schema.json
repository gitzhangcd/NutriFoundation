{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nutrifoundation:udf:u3b:pilot:0.1",
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[^@]+@[a-f0-9]{64}$"
    },
    "slot": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "VALUE"
            },
            "value": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "tag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "PENDING"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "tag",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "UNAVAILABLE"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "tag",
            "reason",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "NOT_APPLICABLE"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "policy_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "tag",
            "reason",
            "policy_ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CommonEnvelope": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^[^@]+$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "PilotMethod",
            "QueryContextRecord",
            "SemanticCandidateRecord"
          ]
        },
        "schema_version": {
          "const": "UDF-U3B-PILOT-0.1"
        },
        "contract_version": {
          "const": "UDF-U3B-PILOT-0.1"
        },
        "lifecycle": {
          "const": "DRAFT"
        },
        "producer_role": {
          "type": "string"
        },
        "created_time": {
          "type": "string",
          "format": "date-time"
        },
        "clock_axis": {
          "const": "AUDIT_UTC"
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "dependency_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "source_class": {
          "enum": [
            "REAL_DATA",
            "REAL_DOCUMENT",
            "NATIVE_JUDGMENT"
          ]
        },
        "instance_class": {
          "enum": [
            "REAL_SOURCE_GROUNDED",
            "MIXED_CONSTRUCTED"
          ]
        },
        "purpose_release_ref": {
          "type": "object",
          "properties": {
            "tag": {
              "const": "PENDING"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "tag",
            "reason"
          ],
          "additionalProperties": false
        },
        "purpose": {
          "const": "CURATION_DEV"
        },
        "supersedes_ref": {
          "$ref": "#/$defs/slot"
        },
        "payload": {
          "type": "object"
        },
        "governance": {
          "type": "object",
          "properties": {
            "legacy_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "legacy_schema_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "stage": {
              "const": "U3-B"
            },
            "construction_class": {
              "enum": [
                "OBS",
                "CON",
                "DRV",
                "UNDECLARED_AT_OBJECT_LEVEL"
              ]
            },
            "verification_scope": {
              "type": "string"
            },
            "rights_domains": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "release_status": {
              "const": "HOLD"
            },
            "policy_version": {
              "const": "UDF-U3B-PILOT-0.1"
            },
            "semantic_overlay": {
              "type": "object",
              "properties": {
                "declared_component_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "effective_component_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "record_definition_status": {
                  "type": "string"
                },
                "source_quantity_kind": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "target_quantity_kind": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "unit_relation": {
                  "type": "string"
                },
                "value_availability": {
                  "type": "string"
                },
                "measurement_equivalence": {
                  "const": "NOT_QUALIFIED"
                }
              },
              "required": [
                "measurement_equivalence"
              ],
              "additionalProperties": false
            },
            "quality_ref": {
              "$ref": "#/$defs/ref"
            },
            "quality_status": {
              "enum": [
                "HOLD_SOURCE_TOTAL_CONFLICT",
                "WITHIN_EXPLORATORY_TOLERANCE_NOT_QUALIFIED"
              ]
            },
            "candidate_risk": {
              "type": "object",
              "properties": {
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rule_version": {
                  "type": "string"
                },
                "legacy_review_route": {
                  "type": "string"
                }
              },
              "required": [
                "flags",
                "rule_version",
                "legacy_review_route"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "legacy_ref",
            "legacy_schema_version",
            "stage",
            "construction_class",
            "verification_scope",
            "rights_domains",
            "release_status",
            "policy_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "object_id",
        "revision_id",
        "kind",
        "schema_version",
        "contract_version",
        "lifecycle",
        "producer_role",
        "created_time",
        "clock_axis",
        "provenance_refs",
        "dependency_refs",
        "source_class",
        "instance_class",
        "purpose_release_ref",
        "purpose",
        "supersedes_ref",
        "payload",
        "governance"
      ],
      "additionalProperties": false
    },
    "PilotMethod": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonEnvelope"
        },
        {
          "properties": {
            "kind": {
              "const": "PilotMethod"
            },
            "payload": {
              "type": "object",
              "properties": {
                "profile_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "model_manifest_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "model_revision": {
                  "type": "string"
                },
                "model_name": {
                  "type": "string"
                },
                "model_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "tokenizer_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "target_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "target_scope_counts": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "model_execution": {
                  "type": "string"
                },
                "score_interpretation": {
                  "type": "string"
                },
                "top_k_pool": {
                  "type": "integer",
                  "minimum": 1
                },
                "top_k_shortlist": {
                  "type": "integer",
                  "minimum": 1
                },
                "retrieval_method": {
                  "type": "string"
                }
              },
              "required": [
                "profile_sha256",
                "model_manifest_sha256",
                "model_revision",
                "model_name",
                "model_sha256",
                "tokenizer_sha256",
                "target_count",
                "target_scope_counts",
                "model_execution",
                "score_interpretation",
                "top_k_pool",
                "top_k_shortlist",
                "retrieval_method"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "QueryContextRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonEnvelope"
        },
        {
          "properties": {
            "kind": {
              "const": "QueryContextRecord"
            },
            "payload": {
              "type": "object",
              "properties": {
                "source_ref": {
                  "$ref": "#/$defs/ref"
                },
                "source_legacy_ref": {
                  "$ref": "#/$defs/ref"
                },
                "source_anchor_ref": {
                  "$ref": "#/$defs/ref"
                },
                "source_scope": {
                  "type": "string"
                },
                "source_grain": {
                  "type": "string"
                },
                "cohort": {
                  "enum": [
                    "PAIRED_DEV",
                    "FRESH_DEV"
                  ]
                },
                "native_label": {
                  "type": "string"
                },
                "native_alias_raw": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "native_ingredient_names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "state_tokens": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "artifact_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_locator": {
                  "type": "object"
                },
                "context_locator": {
                  "type": "object"
                },
                "label_query": {
                  "type": "string"
                },
                "context_query": {
                  "type": "string"
                },
                "baseline_candidate_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "context_qualification": {
                  "const": "SOURCE_LABEL_AND_REFERENCE_RECIPE_ONLY"
                }
              },
              "required": [
                "source_ref",
                "source_legacy_ref",
                "source_anchor_ref",
                "source_scope",
                "source_grain",
                "cohort",
                "native_label",
                "native_alias_raw",
                "native_ingredient_names",
                "state_tokens",
                "artifact_sha256",
                "source_locator",
                "context_locator",
                "label_query",
                "context_query",
                "baseline_candidate_count",
                "context_qualification"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "SemanticCandidateRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/CommonEnvelope"
        },
        {
          "properties": {
            "kind": {
              "const": "SemanticCandidateRecord"
            },
            "payload": {
              "type": "object",
              "properties": {
                "source_ref": {
                  "$ref": "#/$defs/ref"
                },
                "target_ref": {
                  "$ref": "#/$defs/ref"
                },
                "source_legacy_ref": {
                  "$ref": "#/$defs/ref"
                },
                "target_legacy_ref": {
                  "$ref": "#/$defs/ref"
                },
                "query_ref": {
                  "$ref": "#/$defs/ref"
                },
                "method_ref": {
                  "$ref": "#/$defs/ref"
                },
                "source_anchor_ref": {
                  "$ref": "#/$defs/ref"
                },
                "target_anchor_ref": {
                  "$ref": "#/$defs/ref"
                },
                "source_grain": {
                  "type": "string"
                },
                "target_grain": {
                  "type": "string"
                },
                "target_scope": {
                  "type": "string"
                },
                "label_rank": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "context_rank": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "label_cosine": {
                  "type": "number",
                  "minimum": -1.000001,
                  "maximum": 1.000001
                },
                "context_cosine": {
                  "type": "number",
                  "minimum": -1.000001,
                  "maximum": 1.000001
                },
                "fusion_score": {
                  "type": "number",
                  "minimum": 0
                },
                "pool_rank": {
                  "type": "integer",
                  "minimum": 1
                },
                "selected_rank": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "review_route": {
                  "enum": [
                    "AMBER",
                    "RED"
                  ]
                },
                "risk_flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "candidate_status": {
                  "enum": [
                    "SHORTLIST_PENDING",
                    "HARD_NEGATIVE_CANDIDATE",
                    "UNSELECTED_POOL"
                  ]
                },
                "source_relation_to_target": {
                  "const": "UNRESOLVED"
                },
                "direction": {
                  "const": "SOURCE_RELATION_TO_TARGET"
                },
                "review_status": {
                  "const": "PENDING"
                },
                "accepted_equivalence": {
                  "const": false
                },
                "physical_instance_link": {
                  "const": false
                },
                "measurement_qualification": {
                  "const": "HOLD"
                },
                "permitted_purposes": {
                  "const": [
                    "CURATION_DEV"
                  ]
                },
                "score_interpretation": {
                  "const": "RANK_ONLY_NOT_PROBABILITY"
                }
              },
              "required": [
                "source_ref",
                "target_ref",
                "source_legacy_ref",
                "target_legacy_ref",
                "query_ref",
                "method_ref",
                "source_anchor_ref",
                "target_anchor_ref",
                "source_grain",
                "target_grain",
                "target_scope",
                "label_rank",
                "context_rank",
                "label_cosine",
                "context_cosine",
                "fusion_score",
                "pool_rank",
                "selected_rank",
                "review_route",
                "risk_flags",
                "candidate_status",
                "source_relation_to_target",
                "direction",
                "review_status",
                "accepted_equivalence",
                "physical_instance_link",
                "measurement_qualification",
                "permitted_purposes",
                "score_interpretation"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PilotMethod"
    },
    {
      "$ref": "#/$defs/QueryContextRecord"
    },
    {
      "$ref": "#/$defs/SemanticCandidateRecord"
    }
  ]
}
